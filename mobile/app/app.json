{
  "expo": {
    "name": "Mathukai Organic",
    "slug": "mathukai-operations",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mathukai-organic-logo-transparent.png",
    "scheme": "mathukai-operations",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.mathukai.operations",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/mathukai-organic-logo-transparent.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7FAF8",
          "image": "./assets/images/mathukai-organic-logo-transparent.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#0B5D3B",
          "defaultChannel": "orders",
          "sounds": [
            "./assets/sounds/order_received_voice.wav"
          ]
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "88c8807c-ab4d-414e-9605-cf2dc9ddd228"
      }
    }
  }
}
